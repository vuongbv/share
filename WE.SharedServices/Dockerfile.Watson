
FROM mcr.microsoft.com/dotnet/aspnet:6.0 AS base
WORKDIR /app
EXPOSE 80
EXPOSE 443

FROM mcr.microsoft.com/dotnet/sdk:6.0 AS build
WORKDIR /src
COPY ["WE.SharedServices/WatsonDataReaderWorker/WatsonDataReaderWorker.csproj", "WE.SharedServices/WatsonDataReaderWorker/"]
COPY ["WE.Common/src/Common.csproj", "WE.Common/src/"]

RUN dotnet restore "WE.SharedServices/WatsonDataReaderWorker/WatsonDataReaderWorker.csproj"
COPY . .
WORKDIR "/src/WE.SharedServices/WatsonDataReaderWorker"
RUN dotnet build "WatsonDataReaderWorker.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "WatsonDataReaderWorker.csproj" -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "WatsonDataReaderWorker.csproj.dll"]